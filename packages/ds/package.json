{
  "name": "@portfolio/ds",
  "version": "0.1.0",
  "description": "Extracted design system from the Dinesh Revunuru portfolio — tokens, utilities, and React components.",
  "private": true,
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/ds.css",
    "./tokens.css": "./dist/styles/tokens.css",
    "./tailwind-theme.css": "./dist/styles/tailwind-theme.css",
    "./styles/*": "./dist/styles/*"
  },
  "scripts": {
    "build": "tsup && tailwindcss -i src/styles/tailwind-build.css -o dist/.ds-tw.css && node scripts/bundle-css.mjs",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.2.4",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "tsup": "^8.5.0",
    "typescript": "^5"
  }
}

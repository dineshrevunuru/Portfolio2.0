# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# workspace package build output
packages/*/dist/

# per-developer Claude Code settings (shared .claude/settings.json IS committed)
.claude/settings.local.json

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# compiled output for npm test
.test-build/
# Live-model conversation captures. Useful to diff locally when tuning the
# prompt; not a fixture — the model varies run to run, so committing them would
# read as a baseline nobody can reproduce.
test/snapshots/

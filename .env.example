# Copy to .env.local and fill in. .env.local is gitignored — never commit real keys.
#   cp .env.example .env.local
# Then verify without printing any secret:
#   npm run check:keys

# ── Claude — required for Boo to answer at all ────────────────────────────────
# https://console.anthropic.com/settings/keys
# Set a monthly spend cap in the console too: this endpoint is public.
ANTHROPIC_API_KEY=

# claude-sonnet-5 (default) is the right call for a spoken conversation — the
# visitor is waiting in silence, so time-to-first-word matters more than the
# last few points of composition quality. Switch to claude-opus-5 if you'd
# rather have richer block choices and can live with the extra latency.
BOO_MODEL=claude-sonnet-5

# ── Voice ─────────────────────────────────────────────────────────────────────
# "elevenlabs"  recommended — and already Boo's established voice (see below)
# "browser"     free, no key, but robotic and inconsistent across browsers
# "openai"      OpenAI's TTS endpoint; fine, but you already have an EL voice
#
# NOT offered here: OpenAI Realtime (speech-to-speech). See
# data/workpacks/t60-amazon-conv-commerce/decisions/2026-07-10-voice-engine-realtime.md
# — S2S audio "can't be made deterministic", so the spoken track would be
# model-paraphrased. Boo's whole guardrail is that a number can't be invented;
# with S2S the screen stays safe and the VOICE doesn't. Cascade keeps both.
BOO_VOICE_PROVIDER=elevenlabs

# ── Voice in (speech-to-text) ────────────────────────────────────────────────
# Voice IN. "elevenlabs" = Scribe (accurate, and works in Firefox/Safari where
# the browser recognizer doesn't). "browser" = Web Speech, free but weaker.
# With Scribe on, the browser recognizer still runs where available purely to
# drive the live caption — Scribe's transcript is the one Claude receives.
BOO_STT_PROVIDER=elevenlabs
# scribe_v2 only. scribe_v1 is still accepted but ElevenLabs marks it Deprecated
# ("outclassed by v2 models") — it is not a fallback worth having.
ELEVENLABS_STT_MODEL=scribe_v2

# ── ElevenLabs ────────────────────────────────────────────────────────────────
# https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=
# Boo's existing voice — the same one used by aria-portfolio and saathi. Keep it
# unless you're deliberately re-casting; a portfolio and its predecessor sounding
# like two different people is a tell.
ELEVENLABS_VOICE_ID=X03mvPuTfprif8QBAVeJ
# turbo is what the other two projects use. eleven_flash_v2_5 is lower latency
# if you'd rather trade a little richness for a faster first word.
ELEVENLABS_MODEL=eleven_turbo_v2_5

# ── OpenAI (only when BOO_VOICE_PROVIDER=openai) ──────────────────────────────
# https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_TTS_MODEL=gpt-4o-mini-tts
# alloy · echo · fable · onyx · nova · shimmer
OPENAI_TTS_VOICE=alloy

# ── Analytics ─────────────────────────────────────────────────────────────────
# Microsoft Clarity project id — session replay, heatmaps, rage/dead clicks.
# https://clarity.microsoft.com → Settings → Setup → the 10-char id in the tag.
#
# Public by design (it ships in the page source on every analytics tool), so
# this is NEXT_PUBLIC_ and is not a secret. Set it in Vercel's PRODUCTION scope
# only: app/components/Clarity.tsx additionally refuses to load anywhere but
# dineshrevunuru.com, so previews and localhost cannot pollute the heatmaps.
#
# Leave blank to disable tracking entirely — the component renders null.
NEXT_PUBLIC_CLARITY_PROJECT_ID=

# ── Local development only ────────────────────────────────────────────────────
# Points the Claude call at a mock upstream. Leave unset in real use.
# BOO_API_URL=
